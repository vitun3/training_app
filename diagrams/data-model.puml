@startuml
class User {
  id
  email
  name
}
class TrainingPlan {
  id
  userId
  title
}
class WorkoutSession {
  id
  planId
  userId
  startedAt
  completedAt
}
class SocialPost {
  id
  userId
  content
}
User --> TrainingPlan : creates
User --> WorkoutSession : logs
User --> SocialPost : publishes
TrainingPlan --> WorkoutSession : contains
@enduml
